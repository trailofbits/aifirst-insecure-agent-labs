# LangSmith Configuration (optional)
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=your_langsmith_api_key_here
LANGCHAIN_PROJECT=chatbot-framework
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com

# Ollama Configuration (running on host machine)
#
# For Docker (Mac/Windows/Linux):
#   OLLAMA_HOST=http://host.docker.internal:11434
#
# For Podman on Linux:
#   OLLAMA_HOST=http://host.containers.internal:11434
#
# For Podman on Mac/Windows:
#   OLLAMA_HOST=http://host.docker.internal:11434
#
OLLAMA_HOST=http://host.docker.internal:11434
OLLAMA_MODEL=llama3-groq-tool-use:8b

# Content Server Configuration
CONTENT_SERVER_HOST=content-server
CONTENT_SERVER_PORT=8181

# API Configuration
PORT=8000

# Guardrails Configuration
# USE_NEMO_GUARDRAILS: Enable NeMo Guardrails (true) or use regex-based guardrails (false)
USE_NEMO_GUARDRAILS=true

# NEMO_LIGHT_CONFIG: Use lightweight NeMo config (heuristics only, faster) or full config (LLM-based checks)
# true = faster, less sophisticated (heuristics only)
# false = slower, more sophisticated (includes LLM self-checks)
NEMO_LIGHT_CONFIG=false
